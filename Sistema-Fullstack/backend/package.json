{
  "name": "ticketing-backend",
  "version": "1.0.0",
  "description": "API REST para gestion de tickets con Node, Express y MariaDB",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec tsx src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:seed": "tsx src/scripts/seedDb.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "nodemon": "^3.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
